# TLE Data Directory Configuration
# Copy this file to .env and customize for your environment
#
# IMPORTANT: Use relative path (../tle_data)
# - orbit-engine, handover-rl, and tle_data are sibling directories
# - This ensures portability across different systems and locations
# - Parent directory name/location can change without breaking paths
#
# Repository Structure:
#   parent_directory/
#   ├─ orbit-engine/     (this repo)
#   ├─ handover-rl/      (sibling repo)
#   └─ tle_data/         (sibling repo, shared TLE data)

# Relative path to sibling tle_data directory (RECOMMENDED)
# Local TLE Data Configuration
SATELLITE_TLE_DATA_DIR=../tle_data

# Test and Sampling Modes
ORBIT_ENGINE_TEST_MODE=0
ORBIT_ENGINE_SAMPLING_MODE=0

# ============================================================================
# Pool Selection (已廢棄 - 統一使用 Elite Pool)
# ============================================================================
# DEPRECATION NOTICE: 此環境變數已廢棄，將在未來版本移除
#
# 設計說明:
# - Stage 4 會產生兩個池:
#   1. Candidate Pool (3,100 顆) - 初步篩選的可見衛星
#   2. Elite Pool (129 顆) - 優化後的精英衛星池
#
# - 前端渲染和 RL 訓練都應使用 Elite Pool (129 顆)
# - Candidate Pool 僅為 Stage 4 的中間產物
#
# 預設值: false (使用 Elite Pool - 推薦)
# 保留選項: true (使用未優化的 Candidate Pool - 僅供實驗對比)
#
# 建議: 不要設定此變數，使用預設值即可
# ORBIT_ENGINE_STAGE5_USE_CANDIDATE_POOL=false
